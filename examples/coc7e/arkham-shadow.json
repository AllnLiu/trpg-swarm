  "clueGraph": {
    "nodes": [
      {
        "clueId": "clue-1-wax-cylinder",
        "title": "亞瑟的留聲機蠟筒 (Arthur's Phonograph Cylinder)",
        "foundInScene": "scene-1-miskatonic-archive",
        "requiredSkill": "Listen (聆聽) 或 Language: Aklo / Occult",
        "content": "蠟筒中除了刺耳的潮水聲與亞瑟驚恐的喘息外，還有一段用非人喉音反覆吟誦的詞句：『Iä! Dagon! Iä! Hydra! 朔月潮起，塞壬歸巢，第四貨倉之門將於子夜開啟，獻上混血叛徒之血！』背景可聽見阿卡姆 4 號碼頭特有的霧角低鳴（每 15 秒兩長一短）。",
        "sanityLoss": "0/1",
        "leadsTo": ["scene-2-riverside-boarding-house", "scene-3-pier-4-warehouse"]
      },
      {
        "clueId": "clue-2-tiara-rubbing",
        "title": "深海黃金頭冠拓印圖與《水神克塔亞特》批註",
        "foundInScene": "scene-1-miskatonic-archive",
        "requiredSkill": "Library Use (圖書館使用) 或 Archaeology (考古學)",
        "content": "亞瑟在失蹤前借閱了《水神克塔亞特》，書頁間夾著一張來自印斯茅斯馬什家族的金質頭冠拓印。拓印背面用鉛筆寫著：『河畔旅店 204 室的保險箱裡藏著我從祖父祠堂偷出的星石舊印（Elder Sign）。如果他們今晚抓走我，唯有把舊印嵌入海蝕洞的玄武岩方尖碑，才能阻止深潛者母體甦醒！』",
        "sanityLoss": "0/0",
        "leadsTo": ["scene-2-riverside-boarding-house", "scene-4-sunken-sea-cave"]
      },
      {
        "clueId": "clue-3-elder-sign-amulet",
        "title": "五芒星灰岩舊印與破門黏液足跡 (The Lead-Inlaid Elder Sign)",
        "foundInScene": "scene-2-riverside-boarding-house",
        "requiredSkill": "Spot Hidden (偵查) 或 Locksmith (鎖匠)",
        "content": "204 室窗戶從外側被帶有魚蹼與吸盤的怪力震碎，地板殘留著散發腥臭的海藻與灰綠色鱗片（目擊或化驗損失 0/1d2 SAN）。在壁爐鬆動的磚塊後方暗格（Spot Hidden 困難成功或由洛克撬開地板），找到了亞瑟藏匿的『星石舊印』與一把標註『4 號碼頭塞壬號船長室』的黃銅鑰匙。",
        "sanityLoss": "0/1d2",
        "leadsTo": ["scene-3-pier-4-warehouse", "scene-4-sunken-sea-cave"]
      },
      {
        "clueId": "clue-4-cargo-manifest",
        "title": "塞壬號血跡航海日誌與地下水道暗門",
        "foundInScene": "scene-3-pier-4-warehouse",
        "requiredSkill": "Spot Hidden (偵查) 或 Occult (神祕學)",
        "content": "貨倉木箱裡裝的不是醃鱈魚，而是從波利尼西亞運來的古老玄武岩雕像碎塊。航海日誌記載達貢密教大祭司『巴納巴斯·馬什』已將亞瑟押入貨倉升降梯下方的『潮汐海蝕洞』，準備在 24:00 漲潮頂峰時將其獻祭給從拉萊耶游來的深潛者長老。",
        "sanityLoss": "0/1d3",
        "leadsTo": ["scene-4-sunken-sea-cave"]
      }
    ]
  },
