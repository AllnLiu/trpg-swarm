  "investigationScenes": [
    {
      "sceneId": "scene-1-research",
      "name": "場景一：房東委託與三處調查（環球報、圖書館、檔案廳）",
      "fogOfWar": "visible",
      "ambientDescription": "1920 年的波士頓。房東諾特先生把鑰匙、地址和 20 元預付款交給你們，請你們查清中心區那棟柯比特宅的來歷，好讓房子租得出去。動身前可以先做功課：環球報地下室的剪報室、中央圖書館、檔案廳。環球報編輯阿提·威爾莫愛擺架子，會刁難外人進剪報室。",
      "availableClues": [
        "clue-1-globe-morgue",
